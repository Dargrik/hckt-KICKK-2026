# Vzor nastavení. Zkopírujte do .env a doplňte hodnoty. Bez nich běží web i API, jen se neposílají SMS.

# SMS brána: simulator | iphone | gosms | twilio | android
SMS_BRANA=simulator
# tajná část adresy webhooku brány (/sms/<brana>/<tajemství>)
SMS_WEBHOOK_SECRET=
# token pro API simulátoru a administrační token
API_TOKEN=
ADMIN_TOKEN=
# denní limit odpovědí na jedno číslo
SMS_LIMIT_DEN=30
# číslo služby, na které senioři píší (ukazuje se jen přihlášeným správcům)
SMS_CISLO_SLUZBY=
# cesta k databázi (výchozí data/cache/dojedeme.db)
DOJEDEME_DB=

# GoSMS.cz
GOSMS_CLIENT_ID=
GOSMS_CLIENT_SECRET=
GOSMS_CHANNEL_ID=

# Android SMS Gateway (sms-gate.app)
SMSGATE_USER=
SMSGATE_PASSWORD=
SMSGATE_URL=
SMSGATE_SIGNING_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CISLO=
